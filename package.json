{
  "name": "open-road-scope",
  "productName": "OpenRoadScope",
  "version": "0.1.0",
  "description": "Cross-platform vehicle data dashboard powered by OBD-II (ELM327)",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "pnpm test:node && pnpm test:web",
    "test:node": "tsx --test \"electron/**/*.test.ts\" \"shared/**/*.test.ts\"",
    "test:web": "vitest run --config vitest.config.ts",
    "test:sidecar": "cd sidecar && .venv/bin/pytest -q",
    "test:all": "pnpm test && pnpm test:sidecar",
    "build:sidecar": "tsx scripts/build-sidecar.ts",
    "start": "electron-vite preview",
    "dev": "tsx scripts/dev.ts",
    "build": "rimraf out && pnpm typecheck && electron-vite build",
    "build:unpack": "pnpm build && pnpm build:sidecar && electron-builder --dir --config electron-builder.config.ts",
    "build:win": "pnpm build && pnpm build:sidecar && electron-builder --config electron-builder.config.ts --win",
    "build:mac": "pnpm build && pnpm build:sidecar && electron-builder --config electron-builder.config.ts --mac",
    "build:linux": "pnpm build && pnpm build:sidecar && electron-builder --config electron-builder.config.ts --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@iconify-json/lucide": "^1.2.101",
    "@types/node": "^22.19.17",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.4.0",
    "electron": "~43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
    "localforage": "^1.10.0",
    "pinia": "^4.0.2",
    "pixi.js": "^8.0.0",
    "prettier": "^3.9.6",
    "reka-ui": "^2.10.1",
    "rimraf": "^6.1.3",
    "sortablejs": "^1.15.7",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^31.1.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.9",
    "vue-eslint-parser": "^10.4.0"
  }
}
